{
  hostname: "docker",
  bind: "::",
  smtpPort: 25,
  securePort: 465,
  submissionPort: 587,

  auth: true,
  starttls: true,
  chunking: true,
  keystore: "/usr/local/robin/keystore.jks",
  keystorepassword: "avengers",
  // Empty: use the JVM's default CA roots (the image's JDK path differs per base image).
  truststore: "",
  truststorepassword: "avengers",
  allowSelfSigned: true,

  service: {
    port: 8080,
    authType: "none",
    authValue: "",
    allowList: ["127.0.0.1", "::1"]
  },
  api: {
    port: 8090,
    authType: "none",
    authValue: "",
    allowList: ["127.0.0.1", "::1"]
  },

  chaosHeaders: true,
  xclientEnabled: true,
  // These cases reuse message sources; retain unique transaction filenames.
  renameHeaderEnabled: false,

  rbl: { enabled: false },

  // dnsjava lookups (MX, RBL, MTA-STS, DANE) go to the test DNS. It serves remote.test and
  // rbl.test and forwards everything else to Docker. Short timeouts keep failing cases fast.
  dns: {
    servers: ["dns-backend"],
    timeoutSeconds: 2
  },
  emailSizeLimit: 10242400,
  envelopesLimit: 100,

  // The whole suite connects from one test-runner IP, and the command count is shared across
  // listeners per IP while each listener applies its own limit. Keep DoS protection on but leave
  // headroom on every listener so the suite's own burst is not tarpitted, and allow more
  // concurrent connections than the test runner's parallel cases (default cap is 10 per IP).
  smtpConfig: {
    dosProtectionEnabled: true,
    maxCommandsPerMinute: 2000,
    maxConnectionsPerWindow: 300,
    maxConnectionsPerIp: 100
  },
  secureConfig: {
    dosProtectionEnabled: true,
    maxCommandsPerMinute: 2000,
    maxConnectionsPerWindow: 300,
    maxConnectionsPerIp: 100
  },
  submissionConfig: {
    dosProtectionEnabled: true,
    maxCommandsPerMinute: 2000,
    maxConnectionsPerWindow: 300,
    maxConnectionsPerIp: 100
  }
}
