{
  // Scripted remote mailboxes on remote.test, applied to every client ("*" matches any EHLO).
  // Values are regular expressions matched against the whole address. An optional +tag lets
  // each case use its own address (tempfail+mycase@remote.test) so parallel cases never see
  // each other's retries or bounces. Any other recipient is accepted and stored.
  "*": {
    rcpt: [
      { value: "tempfail(\\+[\\w.-]+)?@remote\\.test", response: "450 4.2.1 Mailbox temporarily unavailable" },
      { value: "tempfail-full(\\+[\\w.-]+)?@remote\\.test", response: "452 4.2.2 Mailbox full, try again later" },
      { value: "greylist(\\+[\\w.-]+)?@remote\\.test", response: "450 4.7.1 Greylisted, please retry" },
      { value: "permfail(\\+[\\w.-]+)?@remote\\.test", response: "550 5.1.1 User unknown" },
      { value: "permfail-quota(\\+[\\w.-]+)?@remote\\.test", response: "552 5.2.2 Mailbox quota exceeded" },
      { value: "permfail-policy(\\+[\\w.-]+)?@remote\\.test", response: "553 5.7.1 Rejected by policy" }
    ]
  }
}
