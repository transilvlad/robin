COMPOSE_FILE=docker-compose.yaml:docker-compose.override.yaml:docker-compose.production.yaml
MAIL_HOSTNAME={{ robin_suite_mail_hostname }}
MAIL_TLS_DIR={{ robin_suite_tls_dir }}
MAIL_BIND=0.0.0.0
WEBMAIL_HTTP_PORT=8888
ROBIN_IMAGE=robin-suite:{{ robin_suite_revision }}
POSTGRES_IMAGE={{ robin_suite_images.postgres }}
REDIS_IMAGE={{ robin_suite_images.redis }}
CLAMAV_IMAGE={{ robin_suite_images.clamav }}
RSPAMD_IMAGE={{ robin_suite_images.rspamd }}
DOVECOT_IMAGE={{ robin_suite_images.dovecot }}
ROUNDCUBE_IMAGE={{ robin_suite_images.roundcube }}
ROBIN_ADMIN_VERSION={{ robin_suite_admin_version }}
ROBIN_ADMIN_PUBLIC_URL={{ robin_suite_admin_url }}
ADMIN_HTTPS_BIND=127.0.0.1
ADMIN_HTTPS_PORT=3443
SESSION_SECRET={{ robin_suite_secrets.session }}
ROBIN_ADMIN_ENCRYPTION_KEY={{ robin_suite_secrets.encryption }}
DB_PASSWORD={{ robin_suite_secrets.admin_db }}
MONITOR_DB_PASSWORD={{ robin_suite_secrets.monitor_db }}
SUITE_AGENT_CREDENTIAL={{ robin_suite_secrets.agent }}
MODULE_PROXY_SECRETS_JSON={"robin-tools":"{{ robin_suite_secrets.tools_proxy }}","robin-qa":"{{ robin_suite_secrets.qa_proxy }}","robin-sheriff":"{{ robin_suite_secrets.sheriff_proxy }}"}
MODULE_INSTALLER_SIGNING_SECRET=
NODE_ENV=production
COOKIE_SECURE=true
