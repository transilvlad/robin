{
  hostname: "{$secret:MAIL_HOSTNAME}",
  bind: "::",
  smtpPort: 25,
  securePort: 465,
  submissionPort: 587,
  auth: true,
  starttls: true,
  chunking: true,
  pemCert: "/run/robin-tls/fullchain.pem",
  pemKey: "/run/robin-tls/privkey.pem",
  allowSelfSigned: false,
  truststore: "",
  chaosHeaders: false,
  xclientEnabled: false,
  renameHeaderEnabled: false,
  emailSizeLimit: 20971520,
  envelopesLimit: 100,
  dnsNegativeTtl: 300,
  senderAuthorization: { enabled: true },
  recipientRouting: {
    enabled: true, allowExternalForwarding: false, maxDepth: 10, maxRecipients: 100
  },
  // Process-local starting budgets; review these against each tenant's sending policy.
  submissionLimits: {
    enabled: true, windowSeconds: 3600,
    account: {
      messages: 200, recipients: 1000, bytes: 104857600,
      concurrentConnections: 5, authFailures: 20
    },
    domain: {
      messages: 2000, recipients: 10000, bytes: 1073741824,
      concurrentConnections: 50
    }
  },
  service: { port: 8080, authType: "basic", allowList: [], authValue: "{$secret:ROBIN_API_AUTH}" },
  api: { port: 8090, authType: "basic", allowList: [], authValue: "{$secret:ROBIN_API_AUTH}" },
  rbl: { enabled: false },
  smtpConfig: {
    backlog: 50, errorLimit: 3, envelopeLimit: 100,
    maximumPoolSize: 20, minimumPoolSize: 2, recipientsLimit: 100,
    messageSizeLimit: 20971520, tarpitDelayMillis: 1000, transactionsLimit: 305,
    maxConnectionsPerIp: 10, maxTotalConnections: 100, threadKeepAliveTime: 120,
    dosProtectionEnabled: true, maxCommandsPerMinute: 100,
    maxDataTimeoutSeconds: 300, rateLimitWindowSeconds: 60,
    maxConnectionsPerWindow: 30, minDataRateBytesPerSecond: 10240
  },
  secureConfig: {
    backlog: 50, errorLimit: 3, envelopeLimit: 100,
    maximumPoolSize: 20, minimumPoolSize: 2, recipientsLimit: 100,
    messageSizeLimit: 20971520, tarpitDelayMillis: 1000, transactionsLimit: 500,
    maxConnectionsPerIp: 10, maxTotalConnections: 100, threadKeepAliveTime: 120,
    dosProtectionEnabled: true, maxCommandsPerMinute: 100,
    maxDataTimeoutSeconds: 300, rateLimitWindowSeconds: 60,
    maxConnectionsPerWindow: 30, minDataRateBytesPerSecond: 10240
  },
  submissionConfig: {
    backlog: 50, errorLimit: 3, envelopeLimit: 100,
    maximumPoolSize: 20, minimumPoolSize: 2, recipientsLimit: 100,
    messageSizeLimit: 20971520, tarpitDelayMillis: 1000, transactionsLimit: 500,
    maxConnectionsPerIp: 10, maxTotalConnections: 100, threadKeepAliveTime: 120,
    dosProtectionEnabled: true, maxCommandsPerMinute: 100,
    maxDataTimeoutSeconds: 300, rateLimitWindowSeconds: 60,
    maxConnectionsPerWindow: 30, minDataRateBytesPerSecond: 10240
  }
}
