{
  host: "spam-backend",
  port: 11333,
  enabled: true,
  timeout: 30,
  spfScanEnabled: true,
  dkimScanEnabled: true,
  dmarcScanEnabled: true,
  rejectThreshold: 15.0,
  // Reject rather than silently lose mail; discard is an explicit operator opt-in.
  discardEnabled: false,
  discardThreshold: 25.0,
  dkimSigning: { enabled: false }
}
