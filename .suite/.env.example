# Settings for the Robin suite. Copy to .suite/.env and fill in every value.
# Generate secrets with: openssl rand -hex 32

# Mail identity. The default/demo compose uses bundled local TLS material.
# Production deployments must set MAIL_HOSTNAME and MAIL_TLS_DIR and include
# docker-compose.production.yaml; fullchain.pem and privkey.pem must match.
MAIL_HOSTNAME=localhost
MAIL_TLS_DIR=
MAIL_BIND=0.0.0.0
WEBMAIL_HTTP_PORT=8888

# Mailbox backend: dovecot (default) or cyrus. Choose before the first start;
# switching later requires migrating mailboxes (see the suite documentation).
MAILBOX_BACKEND=dovecot

# Robin Admin, the suite's web UI (https://localhost:3443).
ROBIN_ADMIN_VERSION=1.0.0
ROBIN_ADMIN_PUBLIC_URL=https://localhost:3443
# Robin Admin is published on 127.0.0.1 by default. Set this only when an
# external reverse proxy or firewall safely controls access to the gateway.
ADMIN_HTTPS_BIND=127.0.0.1
ADMIN_HTTPS_PORT=3443
SESSION_SECRET=
ROBIN_ADMIN_ENCRYPTION_KEY=
# Robin Admin's own non-superuser database role (robin_admin).
DB_PASSWORD=
# Read-only PostgreSQL monitoring role (robin_monitor), not the database owner.
# Use hex secrets here: this value is interpolated into a PostgreSQL URI.
MONITOR_DB_PASSWORD=
# PostgreSQL owner, MTA, mailbox reader, Cyrus admin and Roundcube passwords
# are separate files under .suite/secrets/. Generate them with .suite/init-secrets.sh.
# Credential for the co-located agent that manages the suite's containers.
SUITE_AGENT_CREDENTIAL=
# Per-module proxy secrets, shared with each module's own MODULE_PROXY_SECRET.
MODULE_PROXY_SECRETS_JSON={"robin-tools":"","robin-qa":"","robin-sheriff":""}
# Keep unset by default. Enable explicitly with --profile installer only on a
# trusted host: the installer has access to the Docker socket.
MODULE_INSTALLER_SIGNING_SECRET=

# Admin uses secure session cookies; expose webmail only behind HTTPS.
NODE_ENV=production
COOKIE_SECURE=true
