{
  $schema: "../../../../../../main/resources/schema/case.schema.json",

  // Test: submission with a wrong password is refused.
  // Flow: port 587 → STARTTLS → AUTH PLAIN as tony with a wrong password.
  // Validates: AUTH gets 535 and the client never gets to send a message.

  mx: ["127.0.0.1"],
  port: 2587,
  tls: true,

  auth: true,
  user: "tony@example.com",
  pass: "not-starks-password",
  authMechanism: "PLAIN",

  envelopes: [
    {
      mail: "tony@example.com",
      rcpt: ["bad-password@remote.test"],
      subject: "Must not be sent",
      message: "Authentication failed, so this must never be accepted.",
      assertions: {
        protocol: [
          ["DATA", "^250", "none"]
        ]
      }
    }
  ],

  assertions: {
    protocol: [
      ["SMTP", "^220"],
      ["AUTH", "^535"],
      ["AUTH", "^235", "none"]
    ]
  }
}
