{
  $schema: "../../../../../../main/resources/schema/case.schema.json",

  // Self-test: MUST FAIL. A delivered message asserted as absent.
  // Proves `absent: true` fails as soon as the message is found.
  route: "docker",
  tls: true,
  envelopes: [
    {
      mail: "tony@example.com",
      rcpt: ["pepper@example.com"],
      file: "src/test/resources/cases/sources/lipsum.eml",
      assertions: {
        protocol: [
          ["DATA", "^250"]
        ],
        external: [
          {
            type: "imap",
            wait: 3,
            delay: 2,
            retry: 5,
            host: "127.0.0.1",
            port: 2143,
            user: "pepper@example.com",
            pass: "potts",
            folder: "INBOX",
            absent: true
          }
        ]
      }
    }
  ]
}
