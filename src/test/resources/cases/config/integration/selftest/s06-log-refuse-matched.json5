{
  $schema: "../../../../../../main/resources/schema/case.schema.json",

  // Self-test: MUST FAIL. Refuses a log line every accepted message produces.
  // Proves `refuse` fails the case when matched.
  route: "docker",
  tls: true,
  envelopes: [
    {
      mail: "tony@example.com",
      rcpt: ["pepper@example.com"],
      file: "src/test/resources/cases/sources/lipsum.eml",
      assertions: {
        protocol: [
          ["DATA", "^250"]
        ],
        external: [
          {
            type: "request",
            wait: 1,
            delay: 2,
            retry: 3,
            request: {
              url: "http://127.0.0.1:28090/logs?q={$transactionUid}",
              type: "GET"
            },
            verify: [ "Received OK" ],
            refuse: [
              [ "Received OK" ]
            ]
          }
        ]
      }
    }
  ]
}
